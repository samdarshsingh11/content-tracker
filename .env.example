# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# .env is gitignored. Never paste these values into a chat, a ticket, or a
# screenshot - a leaked IG access token can post to your account.

# ---------------------------------------------------------------------------
# MySQL / MariaDB  (Hostinger hPanel -> Databases -> Management)
# ---------------------------------------------------------------------------
# MYSQL_HOST: NOT "localhost" when the app runs on your Mac. Hostinger shows the
#   remote host on the Remote MySQL page - often the server hostname or its IP.
#   "localhost" only works for code running on the Hostinger server itself.
# MYSQL_USER / MYSQL_DB: hPanel prefixes both, e.g. u123456789_tracker.
#
# Before this can connect, add your current IP under
#   hPanel -> Databases -> Remote MySQL
# Without that, connections time out with no other explanation.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=
MYSQL_TABLE=content_items
MYSQL_CONNECT_TIMEOUT=10

# ---------------------------------------------------------------------------
# Meta / Instagram
# ---------------------------------------------------------------------------
# IG_USER_ID is the Instagram *Business* account id (a ~17 digit number).
# It is NOT your @handle and NOT the Facebook Page id.
# Find it:  GET /me/accounts -> page id
#           GET /{page-id}?fields=instagram_business_account
IG_USER_ID=

# A long-lived Page access token (~60 days). Short-lived tokens expire in 1 hour
# and will make publishing fail with error code 190.
# Required permissions: instagram_basic, instagram_content_publish,
#                       pages_show_list, pages_read_engagement
IG_ACCESS_TOKEN=

# From your app at developers.facebook.com -> Settings -> Basic.
# The secret is optional but recommended: when present, every API call is
# signed with appsecret_proof so a stolen token cannot be used elsewhere.
META_APP_ID=
META_APP_SECRET=

# Pin the Graph API version. Meta deprecates versions on a ~2 year cycle.
META_GRAPH_VERSION=v21.0

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8787

# Refuses to publish beyond this many posts per rolling 24h.
# Instagram's own hard limit is 25.
PUBLISH_DAILY_LIMIT=25
